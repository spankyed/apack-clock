{
  "name": "@apackdev/clock",
  "version": "0.1.0",
  "description": "A clock a program is handed: something to run after this long, and the time it is, on one queue and one timer.",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "import": "./dist/queue.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spankyed/apack-clock.git"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:floor": "node node_modules/typescript-5.7/bin/tsc --noEmit -p tsconfig.floor.json",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "package:check": "node scripts/package-check.mjs",
    "package:lint": "node scripts/package-lint.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "workflows:check": "node scripts/workflows-check.mjs",
    "mutants": "stryker run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^24.1.0",
    "@vitest/browser-playwright": "^4.1.12",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "typescript": "^5.9.3",
    "typescript-5.7": "npm:typescript@~5.7.3",
    "vitest": "^4.1.12"
  }
}
